# Database (same settings as Task 1)
# Fixed inside Compose; override for host-side runs.
DB_HOST=db
DB_PORT=5432
DB_NAME=videos
DB_USER=video_user
DB_PASSWORD=video_pass

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional enrichment tuning (defaults shown)
MAX_TEXT_CHARS=8000
REQUEST_TIMEOUT=20
# USER_AGENT=Mozilla/5.0 (compatible; company-enrichment/1.0)
